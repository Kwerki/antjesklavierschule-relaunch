---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import einstellungen from '../data/einstellungen.json';
import { url } from '../lib/url';
import { md } from '../lib/markdown';
import { tel } from '../lib/kontakt';

const start = await getEntry('startseite', 'index');
if (!start) throw new Error('Startseite fehlt: src/content/startseite/index.md');
const { Content } = await render(start);
const d = start.data;
---

<Layout beschreibung={d.beschreibung} bild={d.bild}>
  <section class="held">
    <div class="container held__raster">
      <div class="held__text">
        <p class="held__vorzeile">{einstellungen.untertitel}</p>
        <h1>{d.title}</h1>
        <p class="held__motto">{d.motto}</p>
        <div class="held__aktionen">
          <a class="button" href={url('/kontakt')}>Kennenlernstunde vereinbaren</a>
          <a class="button button--hell" href={tel(einstellungen.telefonFestnetz)}>{einstellungen.telefonFestnetz}</a>
        </div>
      </div>
      <div class="held__bild">
        <img src={url(d.bild)} alt={d.bildAlt} width="1600" height="1067" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="container willkommen">
      <div class="prose textbreite">
        <Content />
      </div>
    </div>
  </section>

  {
    d.kacheln.length > 0 && (
      <section class="abschnitt kacheln-bereich">
        <div class="container">
          <h2 class="zentriert">Was dich in der AtemWelt erwartet</h2>
          <ul class="kacheln">
            {d.kacheln.map((k) => (
              <li>
                <a class="kachel" href={url(k.link)}>
                  <img src={url(k.bild)} alt="" loading="lazy" />
                  <span class="kachel__text">
                    <span class="kachel__titel">{k.titel}</span>
                    {k.text && <span class="kachel__beschreibung">{k.text}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    d.praxis && (
      <section class="abschnitt">
        <div class="container">
          <div class="praxis">
            <img src={url('/images/uploads/logo-angebote.png')} alt="" width="160" loading="lazy" />
            <div>
              <h2>{d.praxis.titel}</h2>
              <div class="prose" set:html={md(d.praxis.text)} />
              <a class="button" href={tel(einstellungen.telefonMobil)}>
                Termin: {einstellungen.telefonMobil}
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .held {
    background:
      radial-gradient(circle at 90% 10%, var(--orange-hell), transparent 45%),
      linear-gradient(180deg, var(--weiss), var(--creme-hell));
    padding-block: clamp(2rem, 6vw, 4.5rem);
    overflow: hidden;
  }
  .held__raster {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .held__vorzeile {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    color: var(--orange);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .held h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    margin-bottom: 0.75rem;
  }
  .held__motto {
    font-size: 1.25rem;
    color: var(--text-leise);
    margin-bottom: 1.75rem;
  }
  .held__aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .held__bild img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 40% 60% 55% 45% / 45% 40% 60% 55%;
    box-shadow: var(--schatten);
  }

  .willkommen {
    display: flex;
    justify-content: center;
    font-size: 1.15rem;
    text-align: center;
  }

  .zentriert {
    text-align: center;
    margin-top: 0;
    margin-bottom: 2rem;
  }
  .kacheln-bereich {
    background: var(--creme);
  }
  .kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .kachel {
    display: block;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    box-shadow: var(--schatten);
    color: var(--weiss);
    text-decoration: none;
  }
  .kachel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .kachel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgb(138 19 32 / 0.9));
  }
  .kachel:hover img {
    transform: scale(1.05);
  }
  .kachel:hover {
    color: var(--weiss);
  }
  .kachel__text {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.25rem;
    z-index: 1;
    display: grid;
    gap: 0.25rem;
  }
  .kachel__titel {
    font-family: var(--schrift-zier);
    font-size: 1.9rem;
    line-height: 1.1;
  }
  .kachel__beschreibung {
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .praxis {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-left: 6px solid var(--orange);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: var(--schatten);
  }
  .praxis h2 {
    margin-top: 0;
  }
  .praxis img {
    width: 160px;
  }

  @media (max-width: 800px) {
    .held__raster {
      grid-template-columns: 1fr;
    }
    .held__bild {
      order: -1;
    }
    .praxis {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .praxis img {
      margin-inline: auto;
      width: 120px;
    }
  }
</style>
