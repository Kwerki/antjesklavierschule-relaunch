---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import { auszug, md } from '../lib/markdown';

const start = await getEntry('startseite', 'index');
if (!start) throw new Error('Startseite fehlt: src/content/startseite/index.md');
const { Content } = await render(start);
const d = start.data;

const neuigkeiten = (await getCollection('aktuelles', ({ data }) => !data.entwurf))
  .sort((a, b) => b.data.datum.valueOf() - a.data.datum.valueOf())
  .slice(0, d.aktuellesAnzahl);
const datumFormat = (datum: Date) => datum.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' });

const ueberMich = await getEntry('seiten', 'ueber-mich');
---

<Layout beschreibung={d.beschreibung} bild={d.bild}>
  <div class="startseite">
  <section class="held">
    <div class="container held__raster">
      <div class="held__text">
        <h1>{d.title}</h1>
        <p class="held__motto">{d.motto}</p>
        <div class="held__aktionen">
          <a class="button" href={url('/kontakt')}>Kennenlernstunde vereinbaren</a>
        </div>
      </div>
      <div class="held__bild">
        <img src={url(d.bild)} alt={d.bildAlt} width="1600" height="1067" fetchpriority="high" />
      </div>
    </div>
  </section>

  {
    neuigkeiten.length > 0 && (
      <section class="abschnitt abschnitt--eng aktuelles reihe-aktuelles" aria-labelledby="aktuelles-titel">
        <div class="container">
          <div class="abschnitt__kopf">
            <h2 id="aktuelles-titel">Aktuelles</h2>
            <a href={url('/aktuelles')}>Alle Neuigkeiten →</a>
          </div>
          <ul class="aktuelles__liste">
            {neuigkeiten.map((n) => (
              <li>
                <a class="meldung" href={url(`/aktuelles#${n.id}`)}>
                  <time datetime={n.data.datum.toISOString().slice(0, 10)}>{datumFormat(n.data.datum)}</time>
                  <span class="meldung__titel">{n.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="abschnitt reihe-willkommen">
    <div class="container willkommen">
      <div class="prose textbreite">
        <Content />
      </div>
    </div>
  </section>

  {
    d.kacheln.length > 0 && (
      <section class="abschnitt kacheln-bereich reihe-kacheln">
        <div class="container">
          <ul class="kacheln">
            {d.kacheln.map((k) => (
              <li>
                <a class="kachel" href={url(k.link)}>
                  <img src={url(k.bild)} alt="" loading="lazy" />
                  <span class="kachel__text">
                    <span class="kachel__titel">{k.titel}</span>
                    {k.text && <span class="kachel__beschreibung">{k.text}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }


  {
    ueberMich && (
      <section class="abschnitt reihe-ueber">
        <div class="container ueber">
          {ueberMich.data.bild && (
            <img class="ueber__bild" src={url(ueberMich.data.bild)} alt={ueberMich.data.bildAlt} loading="lazy" />
          )}
          <div>
            <p class="ueber__vorzeile">Über mich</p>
            <h2>{ueberMich.data.einleitung ?? ueberMich.data.title}</h2>
            <p>{auszug(ueberMich.body, 170)}</p>
            <a class="button" href={url('/ueber-mich')}>Mehr über mich</a>
          </div>
        </div>
      </section>
    )
  }

  {
    d.praxis && (
      <section class="abschnitt reihe-praxis">
        <div class="container">
          <div class="praxis">
            <img src={url('/images/uploads/logo-angebote.png')} alt="" width="160" loading="lazy" />
            <div>
              <h2>{d.praxis.titel}</h2>
              <div class="prose" set:html={md(d.praxis.text)} />
              <a class="button" href={url('/kontakt')}>Termin vereinbaren</a>
            </div>
          </div>
        </div>
      </section>
    )
  }
  </div>
</Layout>

<style>
  .startseite {
    display: flex;
    flex-direction: column;
  }
  .held {
    background:
      radial-gradient(circle at 90% 10%, var(--orange-hell), transparent 45%),
      linear-gradient(180deg, var(--weiss), var(--creme-hell));
    padding-block: clamp(2rem, 6vw, 4.5rem);
    overflow: hidden;
  }
  .held__raster {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .held h1 {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    margin-bottom: 0.75rem;
  }
  .held__motto {
    font-size: 1.25rem;
    color: var(--text-leise);
    margin-bottom: 1.75rem;
  }
  .held__aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .held__bild img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 40% 60% 55% 45% / 45% 40% 60% 55%;
    box-shadow: var(--schatten);
  }

  .willkommen {
    display: flex;
    justify-content: center;
    font-size: 1.15rem;
    text-align: center;
  }

  .zentriert {
    text-align: center;
    margin-top: 0;
    margin-bottom: 2rem;
  }
  .kacheln-bereich {
    background: var(--creme);
  }
  .kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .kachel {
    display: block;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 3 / 4;
    box-shadow: var(--schatten);
    color: var(--weiss);
    text-decoration: none;
  }
  .kachel img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .kachel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgb(138 19 32 / 0.9));
  }
  .kachel:hover img {
    transform: scale(1.05);
  }
  .kachel:hover {
    color: var(--weiss);
  }
  .kachel__text {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.25rem;
    z-index: 1;
    display: grid;
    gap: 0.25rem;
  }
  .kachel__titel {
    font-family: var(--schrift-zier);
    font-size: 1.9rem;
    line-height: 1.1;
  }
  .kachel__beschreibung {
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .abschnitt--eng {
    padding-block: clamp(2rem, 4vw, 3rem);
  }
  .abschnitt__kopf {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }
  .abschnitt__kopf h2 {
    margin: 0;
  }
  .abschnitt__kopf a {
    font-weight: 600;
    text-decoration: none;
  }
  .aktuelles {
    background: var(--weiss);
    border-block: 1px solid var(--linie);
  }
  .aktuelles__liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .meldung {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 1.25rem 1.4rem;
    background: var(--creme-hell);
    border: 1px solid var(--linie);
    border-left: 5px solid var(--orange);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .meldung:hover {
    color: var(--text);
    transform: translateY(-2px);
    box-shadow: var(--schatten);
  }
  .meldung time {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--orange);
    font-weight: 600;
  }
  .meldung__titel {
    font-family: var(--schrift-zier);
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--rot);
  }

  .ueber {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .ueber__bild {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 45% center;
    border-radius: 50%;
    box-shadow: var(--schatten);
  }
  .ueber h2 {
    margin-top: 0.25rem;
  }
  .ueber__vorzeile {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    color: var(--orange);
    font-weight: 600;
    margin: 0;
  }

  .praxis {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-left: 6px solid var(--orange);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: var(--schatten);
  }
  .praxis h2 {
    margin-top: 0;
  }
  .praxis img {
    width: 160px;
  }

  @media (max-width: 800px) {
    .held__raster {
      grid-template-columns: 1fr;
    }
    .held__bild {
      order: -1;
    }
    .ueber {
      grid-template-columns: 1fr;
    }
    .ueber__bild {
      max-width: 22rem;
      margin-inline: auto;
    }
    .praxis {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .praxis img {
      margin-inline: auto;
      width: 120px;
    }
  }

  /* Handy: Kategorien als 2×2-Raster, „Über mich“ vor den Kategorien */
  @media (max-width: 700px) {
    .reihe-ueber {
      order: 1;
    }
    .reihe-kacheln {
      order: 2;
    }
    .reihe-praxis {
      order: 3;
    }
    .willkommen {
      text-align: left;
      font-size: 1.02rem;
    }
    .kacheln {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .kachel {
      aspect-ratio: 1;
    }
    .kachel__text {
      padding: 0.8rem 0.9rem;
    }
    .kachel__titel {
      font-size: 1.35rem;
    }
    .ueber__bild {
      max-width: 13rem;
    }
    .praxis {
      text-align: left;
    }
    .praxis img {
      margin-inline: 0;
      width: 90px;
    }
  }
</style>
