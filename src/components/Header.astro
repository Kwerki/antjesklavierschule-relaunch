---
import { getMenu } from '../lib/navigation';
import { url } from '../lib/url';
import einstellungen from '../data/einstellungen.json';

const menu = await getMenu();
const aktuell = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
---

<header class="kopf">
  <div class="kopf__marke">
    <a class="kopf__logo" href={url('/')} aria-label={`${einstellungen.name} – zur Startseite`}>
      <img src={url('/images/brand/logo-home.png')} alt={`${einstellungen.name} – ${einstellungen.slogan}`} width="744" height="361" />
    </a>
    <button class="kopf__toggle" aria-expanded="false" aria-controls="hauptmenu">
      <span class="kopf__toggle-linien" aria-hidden="true"></span>
      <span>Menü</span>
    </button>
  </div>

  <nav id="hauptmenu" class="kopf__nav" aria-label="Hauptmenü">
    <ul>
      <li>
        <a class="ist-home" href={url('/')} aria-current={aktuell === '/' ? 'page' : undefined} title="Startseite">
          <img src={url('/images/brand/home-note.svg')} alt="" width="28" height="31" />
          <span class="ist-home__text">Startseite</span>
        </a>
      </li>
      {
        menu.map((m) => (
          <li>
            <a
              href={url(m.pfad)}
              class:list={{ 'ist-kontakt': m.pfad === '/kontakt' }}
              aria-current={aktuell === m.pfad ? 'page' : undefined}
            >
              {m.titel}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.kopf__toggle');
  const nav = document.getElementById('hauptmenu');
  toggle?.addEventListener('click', () => {
    const offen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!offen));
    nav?.classList.toggle('offen', !offen);
  });
</script>

<style>
  /* Desktop: Logo-Zeile scrollt weg, die Menüleiste bleibt oben stehen */
  .kopf {
    --logo-zeile: 7.5rem;
    position: sticky;
    top: calc(-1 * var(--logo-zeile));
    z-index: 50;
    background: var(--weiss);
    box-shadow: 0 1px 0 var(--linie);
  }

  .kopf__marke {
    height: var(--logo-zeile);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kopf__logo img {
    width: 230px;
    height: auto;
  }

  .kopf__nav {
    border-top: 1px solid var(--linie);
    background: var(--weiss);
  }
  .kopf__nav ul {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0 auto;
    padding: 0.55rem 1rem;
    max-width: var(--breite);
  }
  .kopf__nav a {
    display: block;
    white-space: nowrap;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.97rem;
    transition: background 0.2s, color 0.2s;
  }
  .kopf__nav a:hover {
    background: var(--creme);
    color: var(--rot);
  }
  .kopf__nav a[aria-current='page'] {
    background: var(--orange-hell);
    color: var(--rot-dunkel);
    font-weight: 600;
  }
  .kopf__nav a.ist-home {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    margin-right: 0.35rem;
  }
  .ist-home img {
    width: 1.55rem;
    height: auto;
    transform-origin: 40% 90%;
    transition: transform 0.25s;
  }
  .ist-home:hover img {
    transform: rotate(-12deg) scale(1.08);
  }
  .ist-home__text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .kopf__nav a.ist-kontakt {
    background: var(--rot);
    color: var(--weiss);
    margin-left: 0.5rem;
    font-weight: 600;
  }
  .kopf__nav a.ist-kontakt:hover,
  .kopf__nav a.ist-kontakt[aria-current='page'] {
    background: var(--orange);
    color: var(--weiss);
  }

  .kopf__toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    background: var(--weiss);
    border: 1px solid var(--linie);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font: inherit;
    color: var(--rot);
    cursor: pointer;
  }
  .kopf__toggle-linien,
  .kopf__toggle-linien::before,
  .kopf__toggle-linien::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    position: relative;
    transition: transform 0.2s, background 0.2s;
  }
  .kopf__toggle-linien::before,
  .kopf__toggle-linien::after {
    content: '';
    position: absolute;
  }
  .kopf__toggle-linien::before {
    top: -6px;
  }
  .kopf__toggle-linien::after {
    top: 6px;
  }
  .kopf__toggle[aria-expanded='true'] .kopf__toggle-linien {
    background: transparent;
  }
  .kopf__toggle[aria-expanded='true'] .kopf__toggle-linien::before {
    transform: translateY(6px) rotate(45deg);
  }
  .kopf__toggle[aria-expanded='true'] .kopf__toggle-linien::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Kleinere Browserfenster: Menüleiste etwas kompakter, Logo-Zeile niedriger */
  @media (max-width: 1150px) {
    .kopf {
      --logo-zeile: 6rem;
    }
    .kopf__logo img {
      width: 190px;
    }
    .kopf__nav ul {
      gap: 0;
      padding-inline: 0.5rem;
    }
    .kopf__nav a {
      padding: 0.4rem 0.6rem;
      font-size: 0.92rem;
    }
    .kopf__nav a.ist-kontakt {
      margin-left: 0.3rem;
    }
  }

  /* Tablet & Handy: kompakte Leiste mit Menü-Knopf */
  @media (max-width: 900px) {
    .kopf {
      --logo-zeile: 4.75rem;
      top: 0;
    }
    .kopf__marke {
      justify-content: space-between;
      padding-inline: 1.25rem;
    }
    .kopf__logo img {
      width: 150px;
    }
    .kopf__toggle {
      display: inline-flex;
    }
    .kopf__nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      box-shadow: var(--schatten);
      max-height: calc(100dvh - var(--logo-zeile));
      overflow-y: auto;
    }
    .kopf__nav.offen {
      display: block;
    }
    .kopf__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.2rem;
      padding: 0.75rem 1.25rem 1.25rem;
    }
    .kopf__nav a {
      padding: 0.75rem 1rem;
      font-size: 1.05rem;
      border-radius: 10px;
    }
    .ist-home img {
      width: 1.3rem;
    }
    .kopf__nav a.ist-home {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      width: auto;
      height: auto;
      padding: 0.75rem 1rem;
      margin: 0;
    }
    .ist-home__text {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
    .kopf__nav a.ist-kontakt {
      margin: 0.5rem 0 0;
      text-align: center;
      border-radius: 999px;
    }
  }
</style>
