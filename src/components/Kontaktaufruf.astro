---
import einstellungen from '../data/einstellungen.json';
import { tel } from '../lib/kontakt';
import { url } from '../lib/url';

interface Props {
  text: string;
  telefon?: 'mobil' | 'festnetz';
}

const { text, telefon = 'mobil' } = Astro.props;
const nummer = telefon === 'festnetz' ? einstellungen.telefonFestnetz : einstellungen.telefonMobil;
---

<aside class="aufruf" aria-label="Kontakt">
  <img src={url('/images/brand/home-note.svg')} alt="" width="40" height="44" />
  <p class="aufruf__text">{text}</p>
  <div class="aufruf__knoepfe">
    <a class="button" href={tel(nummer)}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"></path></svg>
      {nummer}
    </a>
    <a class="button button--hell" href={`mailto:${einstellungen.email}`}>E-Mail schreiben</a>
  </div>
</aside>

<style>
  .aufruf {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: 1.5rem clamp(1.25rem, 3vw, 2rem);
    background: var(--creme);
    border-radius: var(--radius);
  }
  .aufruf img {
    width: 2.4rem;
    height: auto;
  }
  .aufruf__text {
    margin: 0;
    font-size: 1.08rem;
  }
  .aufruf__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  @media (max-width: 760px) {
    .aufruf {
      grid-template-columns: auto 1fr;
    }
    .aufruf__knoepfe {
      grid-column: 1 / -1;
    }
  }
</style>
